{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(npm *)",
      "Bash(npm)",
      "Read(src/**)",
      "WebFetch(domain:example.com)",
      "mcp__local__tool"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf)",
      "Edit(private/**)",
      "Read(.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm run format",
            "timeout": 60,
            "cwd": "."
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git status",
            "timeout": 60,
            "cwd": "."
          }
        ]
      }
    ]
  }
}
