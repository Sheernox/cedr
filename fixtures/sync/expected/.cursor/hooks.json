{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "type": "command",
        "command": "npm run format",
        "timeout": 60,
        "cwd": "."
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "command": "git status",
        "timeout": 60,
        "cwd": "."
      }
    ]
  }
}
